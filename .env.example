# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phabulous_jewellery"

# Authentication & Sessions
AUTH_SECRET="phabulous_super_secret_jwt_and_session_key_min_32_characters_long"
ADMIN_MFA_ENFORCE="true"

# Providers Mode (Default to 'mock' for local development with zero external keys)
PAYMENT_PROVIDER="mock"
SHIPPING_PROVIDER="mock"
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
STORAGE_PROVIDER="local"

# Razorpay (Live or Test keys when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket (When SHIPPING_PROVIDER=shiprocket)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_WEBHOOK_TOKEN=""

# Email (Resend when EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
EMAIL_FROM="orders@phabulousbymitthat.com"

# Cloudflare R2 (When STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Outbox & Cron Jobs
CRON_SECRET="phabulous_cron_secret_key_12345"
